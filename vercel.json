{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ab.anduschile.com" }],
      "destination": "https://artebrisapatagonia.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.artebrisapatagonia.com" }],
      "destination": "https://artebrisapatagonia.com/$1",
      "permanent": true
    },
