# scripts/mapa-huecos — variables de entorno
# Copia este archivo como .env.eval (en esta misma carpeta) y completa con las
# credenciales reales. .env.eval está en .gitignore — nunca se sube al repo.
#
# SUPABASE_SERVICE_ROLE_KEY se necesita porque el script lee reservas sin pasar
# por las políticas RLS pensadas para el sitio público. El script es de SOLO
# LECTURA (no hace insert/update/delete), pero la service role key de todas
# formas da acceso total a la base — trátala como una credencial sensible.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI
