# Arte Brisa Patagonia — Variables de entorno
# Copia este archivo como .env y completa con tus credenciales reales

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# WhatsApp para CTAs (sin + ni espacios)
VITE_WHATSAPP=56912345678

# Analytics (GA4 + Google Ads) — opcional. Sin VITE_GA4_ID, el sitio no carga
# ningún script de medición ni muestra el aviso de cookies.
# VITE_GA4_ID=G-XXXXXXXXXX
# VITE_GADS_ID=AW-XXXXXXXXX
# VITE_ANALYTICS_DEBUG=true
